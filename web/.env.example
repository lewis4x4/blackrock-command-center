# ── BlackRock AI Command Center — web ───────────────────────────────
# Copy to .env and fill in. Only VITE_-prefixed vars reach the browser.

# Control-plane Supabase project (only used to derive VITE_CC_FUNCTIONS_URL by default; the browser does NOT use a Supabase database key).
VITE_SUPABASE_URL=https://gsvhuzpysxaegoecwjmf.supabase.co

# Edge-function base URL for browser read APIs (defaults to ${VITE_SUPABASE_URL}/functions/v1)
# IMPORTANT: when CC_ACCESS_REQUIRED=true, this MUST be an Access-protected hostname/proxy origin.
# Cloudflare Access only injects Cf-Access-Jwt-Assertion to hosts it gates; raw *.supabase.co/functions/v1 will 401.
VITE_CC_FUNCTIONS_URL=https://gsvhuzpysxaegoecwjmf.supabase.co/functions/v1

# Mirror of function-side gate toggle so Files can send the interim read-token header when Access is off.
VITE_CC_ACCESS_REQUIRED=false

# Interim (§8.2 window close): required only while CC_ACCESS_REQUIRED=false (until S1 lands).
# READ-ONLY token for cc-read-artifacts fallback; set as CC_READ_TOKEN in Supabase Function secrets.
# This does NOT authorize cc-index-artifacts or any write/prune endpoint.
# After S1 is in front: set CC_ACCESS_REQUIRED=true and remove this from the web env.
VITE_CC_READ_TOKEN=

# Interim write-path token until Cloudflare Access write gates are fully live.
# Must differ from VITE_CC_READ_TOKEN / CC_READ_TOKEN.
VITE_CC_WRITE_TOKEN=

# true = Home renders sample rows with no backend; false = the Home reads the live cc-read-home / cc-read-audit edge functions. The Files surface ALWAYS reads cc-read-artifacts.
VITE_DEMO_MODE=true
