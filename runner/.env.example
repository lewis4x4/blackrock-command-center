# Control plane connection — service-role only, never browser keys.
CONTROL_PLANE_URL=https://gsvhuzpysxaegoecwjmf.supabase.co
CONTROL_PLANE_SERVICE_KEY=<service_role key — the daemon writes to agent_work_orders / agent_runs>

# GitHub App — required only when RUNNER_MOCK_MODE=false.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=          # PEM; literal multi-line or base64-encoded PEM are both accepted.

# Daemon identity & tuning.
RUNNER_ID=mac-studio-1           # written to claimed_by; appears in audit
POLL_INTERVAL_SECONDS=10
LEASE_SECONDS=600
WORKSPACE_ROOT=/tmp/cc-runner
CONCURRENCY=1                    # this slice supports one active order per host

# Claude Code CLI tuning.
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_TIMEOUT_SECONDS=0    # 0 means no local timeout; lease expiry recovers crashes

# Mock mode for local + smoke testing without GitHub App or Claude Code.
RUNNER_MOCK_MODE=false
